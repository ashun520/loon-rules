#!name=TRAE 每日签到 v1
#!desc=每天 8:05 自动完成 TRAE 签到领取积分，通知回显当前余额；首次需打开一次 TRAE App 让 Loon 捕获登录凭证
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/be/dc/62/bedc62eb-2067-9272-470f-358df07c8027/AppIcon-0-0-1x_U007ephone-0-1-85-220.jpeg/512x512bb.jpg
#!author=ashun520
#!homepage=https://github.com/ashun520/loon-rules

[Script]
http-request ^https?://api\.trae\.cn/ script-path=https://raw.githubusercontent.com/ashun520/loon-rules/main/Trae/trae_token_capture.js, requires-body=0, tag=TRAE 凭证捕获
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/ashun520/loon-rules/main/Trae/trae_checkin.js, tag=TRAE 每日签到, timeout=60, enable=true

[MITM]
hostname = api.trae.cn
