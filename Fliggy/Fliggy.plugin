#!name = 飞猪去广告
#!desc = 飞猪 iOS 去广告：拦截已知广告追踪与营销资源接口，过滤广告资源请求；保留机票、酒店、火车票、订单、支付、登录及核心搜索服务。需开启 MITM 并信任 Loon 证书。
#!author = ashun520（参考公开 Loon / Surge 飞猪规则并保守筛选）
#!homepage = https://github.com/ashun520/loon-rules
#!icon = https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/fliggy.png
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)
#!tag = 去广告,旅行,飞猪
#!type = normal

[Rule]
# 飞猪广告追踪域名（公开规则明确标记）
DOMAIN,ad-track.fliggy.com,REJECT

# 飞猪广告 / 营销资源下发接口
DOMAIN,acs.m.taobao.com,DIRECT
DOMAIN,gw.alicdn.com,DIRECT

[Rewrite]
# CRM 弹窗与开屏/屏幕资源配置：广告资源接口，返回空 JSON
^https?:\\/\\/acs\\.m\\.taobao\\.com\\/gw\\/mtop\\.fliggy\\.crm\\.screen\\.(allresource|predict)(\\/|\\?) reject-dict
^https?:\\/\\/acs\\.m\\.taobao\\.com\\/gw\\/mtop\\.fliggy\\.crm\\.popresource(\\/|\\?) reject-dict

# 飞猪活动营销资源（仅匹配特定接口，不拦截整个活动/交易网关）
^https?:\\/\\/acs\\.m\\.taobao\\.com\\/gw\\/mtop\\.trip\\.activity\\.querytmsresources\\/1\\.0\\?type=originaljson reject-img

# 广告素材 CDN：只拦截公开规则中识别的窄路径，不屏蔽酒店/景点/商品图片
^https?:\\/\\/gw\\.alicdn\\.com\\/mt\\/ reject
^https?:\\/\\/gw\\.alicdn\\.com\\/imgextra\\/\\w{2}\\/[\\w!]+-\\d-tps-\\d{3}-\\d{4}\\.(jpg|png)$ reject

[MITM]
hostname = acs.m.taobao.com, gw.alicdn.com

# 规则依据：
# 1) fmz200/wool_scripts 的 Loon 飞猪规则：CRM screen.allresource/predict、活动 TMS 资源、特定 CDN 素材路径。
# 2) zirawell/R-Store 的飞猪规则：ad-track.fliggy.com、CRM popresource 等端点。
# 未加入首页结构重建、猜你喜欢、AI 助手、通用淘宝广告域或整段 alicdn CDN 拦截，避免误伤旅行内容与交易功能。
# 当前未取得本机 HAR，以上规则属于公开规则依据的保守初版，仍需以实际版本表现验证，不能保证覆盖全部广告。
