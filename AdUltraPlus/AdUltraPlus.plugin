^https?:\/\/v3\.wufazhuce\.com:8000\/api\/adpreloadlist reject-dict
^https?:\/\/www\.hpoi\.net\.cn\/api\/item\/startPage reject-200
^https?:\/\/www\.gcores\.com\/gapi\/v1\/app-start-pages\?page reject-dict
^https?:\/\/www\.oschina\.net\/action\/apiv2\/get_launcher reject-img
^https?:\/\/www\.kujiale\.com\/app\/queryOpenPage reject-200
^https?:\/\/sso\.ifanr\.com\/jiong\/IOS\/appso\/splash\/ reject-200
^https?:\/\/service\.busi\.inke\.cn\/api\/flash\/screen reject-200
^https?:\/\/shopic\.sf-express\.com\/crm\/mobile\/common\/flashscreen reject-200
^https?:\/\/wap\.spdb\.com\.cn\/mspmk-web-homeassist\/OpenScreenAdv\.ah$ reject
^https?:\/\/wcprd\.hilton\.com\.cn\/app-middleware\/graphql\?type=splashAd reject-200
^https?:\/\/thor\.weidian\.com\/ares\/home\.splash reject-200
^https?:\/\/vapp\.tmuyun\.com\/api\/app_start_page\/list\/new reject-dict
^https?:\/\/ytmsout\.radio\.cn\/publish\/recScreen\/getLoadPage reject-200
^https?:\/\/siteapi\.zaixs\.com\/.*\/start_ad reject-200
^https?:\/\/snailsleep\.net\/snail\/v\d\/screen\/qn\/get\? reject

