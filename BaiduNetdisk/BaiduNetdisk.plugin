#!name = 百度网盘强效去广告
#!desc = 修正规则正则转义；清理已知广告接口与素材请求，不伪造会员身份或付费权益。需开启 MITM 并信任 Loon 证书
#!author = ashun520
#!homepage = https://github.com/ashun520/loon-rules
#!icon = https://raw.githubusercontent.com/Thelongdarkorg/loon-plugins/main/icons/baidunetdisk.jpg
#!loon_version = 3.5.1
#!tag = 去广告,百度网盘
#!system = iOS,iPadOS

[Rule]
AND,((DOMAIN,pan.baidu.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,vlion.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,advlion.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
^https:\/\/pan\.baidu\.com\/buy\/ad\/get reject-dict
^https:\/\/pan\.baidu\.com\/buy\/ad\/analytics reject-dict
^https:\/\/pan\.baidu\.com\/api\/analytics\?.*(?:splash|bidding|iOS_key_splash|iOS_bidding) reject-dict
^https:\/\/pan\.baidu\.com\/act\/v\d+\/welfare\/list reject-dict
^https:\/\/pan\.baidu\.com\/rest\/2\.0\/pcs\/ad(?:\?|$) reject-dict
^https:\/\/pan\.baidu\.com\/rest\/\d+\.\d+\/pcs\/adx(?:\?|$) reject-dict
^https:\/\/afd\.baidu\.com\/afd\/entry(?:\?|$) reject-dict
^https:\/\/pan\.baidu\.com\/api\/taskscore\/tasklist(?:\?|$) reject-dict
^https:\/\/pan\.baidu\.com\/coins\/center\/notice(?:\?|$) reject-dict
^https:\/\/pan\.baidu\.com\/api\/useractivity\/activity(?:\?|$) reject-dict
^https:\/\/[^/]+\.vlion\.cn\/.+ reject-200
^https:\/\/[^/]+\.advlion\.com\/.+ reject-200

[Script]
response if ${url} ~= /^https?:\/\/pan\.baidu\.com\/(?:act\/.+\/(?:activityentry|bchannel|cardwelfare)|feed\/cardinfos|buy\/ad\/conf|rest\/.+\/(?:pcs\/adv|membership\/proxy\/guide))/ then script("baidu_response.js") with requires_body=true, tag="百度网盘广告响应净化"

[MITM]
hostname = pan.baidu.com, afd.baidu.com, *.vlion.cn, *.advlion.com
