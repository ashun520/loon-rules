#!name = 陌陌去广告
#!desc = 陌陌 iOS 去广告：拦截陌陌自有广告域，并通过 MITM 清洗启动/信息流/推荐/搜索/附近/动态接口中的广告卡片与广告字段。首次安装后请杀掉 App 重开；开屏广告有本地缓存，需等缓存过期或清除 App 缓存后再验证。
#!author = ashun520
#!homepage = https://github.com/ashun520/loon-rules
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/23/ce/08/23ce08ba-6c13-a024-0cba-41c16e380c92/AppIcon-0-0-1x_U007emarketing-0-4-0-85-220.png/512x512bb.jpg
#!system = iOS,iPadOS
#!loon_version = 3.5.1
#!tag = 去广告,陌陌

[Rule]
# 陌陌自有广告投放域（含其子域）
DOMAIN-SUFFIX,ad.immomo.com,REJECT
DOMAIN-SUFFIX,openad.immomo.com,REJECT
DOMAIN-SUFFIX,game-ad.immomo.com,REJECT
# 广告后台/测试域，客户端正常不会访问，出现即拦截
DOMAIN-SUFFIX,ad-admin.immomo.com,REJECT

# QUIC 定向阻断：保证域名规则与 MITM 对 HTTP/3 请求同样生效
AND,((DOMAIN-SUFFIX,ad.immomo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,openad.immomo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,game-ad.immomo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ad-admin.immomo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,api.immomo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,api-alpha.immomo.com),(PROTOCOL,QUIC)),REJECT

[Script]
# 启动/开屏、信息流、推荐、搜索、附近、动态接口：清洗广告字段与广告卡片
http-response ^https?:\/\/api(?:-alpha)?\.immomo\.com\/[^\s]*(?:[Ss]tartup|[Ll]aunch|[Ss]plash|[Ff]eed|[Rr]ecommend|[Ss]earch|[Nn]earby|[Dd]ynamic)[^\s]*$ requires-body=1,script-path=https://raw.githubusercontent.com/ashun520/loon-rules/main/Momo/momo_cleaner.js?v=20261112, max-size=10485760, timeout=30, tag=陌陌广告清洗

[Mitm]
hostname = api.immomo.com, api-alpha.immomo.com

# 说明：
# 1. 陌陌核心接口 api.immomo.com 同时承载聊天、动态、直播等业务，本插件只对启动/信息流类接口做 JSON 清洗，不整域拦截。
# 2. 若开屏广告来自穿山甲、优量汇、快手联盟等第三方 SDK，请配合 BlockAdvertisers（可莉）等通用插件。
# 3. 若仍有广告，请在 Loon「请求」日志中筛选 immomo，把开屏瞬间出现的广告请求完整 URL 发回，
#    可据此补充精确到接口的规则（与 B 站插件同级别的处理方式）。
