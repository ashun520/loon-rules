#!name = 懂车帝去广告 v5
#!desc = 懂车帝去广告：拦截开屏广告配置与广告素材域、清理首页/文章/搜索信息流广告；不拦截内容视频域，需开启 MITM 并信任 Loon 证书。
#!author = ashun520
#!homepage = https://github.com/ashun520/loon-rules
#!icon = https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/5e/71/f0/5e71f0e9-90d3-5479-9ce4-ed3b417b289c/DCDAppIcon-0-0-1x_U007epad-0-1-0-85-220.png/512x512bb.jpg
#!loon_version = 3.5.1
#!tag = 去广告,懂车帝
#!system = iOS,iPadOS

[Rule]
# 懂车帝开屏广告视频素材专用域名（与内容视频域分离）
DOMAIN,v26-dcar-ad.dcarvod.com,REJECT
# 同一广告素材桶的版本/前缀变化兜底；只匹配带 -ad.dcarvod.com 的主机，不拦截普通内容桶
DOMAIN-KEYWORD,-ad.dcarvod.com,REJECT
# QUIC 定向兜底：仅阻断上述已确认广告素材主机的 QUIC，不全局禁用其他 App 的 QUIC
AND,((DOMAIN,v26-dcar-ad.dcarvod.com),(PROTOCOL,QUIC)),REJECT

# 第三方广告曝光与点击监测（跨 App 通用监测服务）
DOMAIN-SUFFIX,miaozhen.com,REJECT
DOMAIN-SUFFIX,ctrmi.cn,REJECT
DOMAIN-SUFFIX,gridsumdissector.com,REJECT
# 第三方曝光/点击监测域的 QUIC 定向阻断
AND,((DOMAIN-SUFFIX,miaozhen.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ctrmi.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,gridsumdissector.com),(PROTOCOL,QUIC)),REJECT

# 强制 API 走 TCP，否则 HTTP/3 流量无法被 MITM 重写
AND,((DOMAIN-SUFFIX,dcarapi.com),(PROTOCOL,QUIC)),REJECT

# 字节数据埋点/上报域：必须在 TLS 前 REJECT（不会被 MITM 解密，WebView 不会弹证书告警）
DOMAIN-SUFFIX,datasail-cn-beijing.dcarapi.com,REJECT

[Rewrite]

# ===== 首页信息流：去掉“广告”标签条目、节目卡与视频详情卡 =====
^https?:\/\/[a-zA-Z0-9.-]*dcarapi\.com\/motor\/stream_entrance\/get_feed(\/|\?|$) response-body-json-jq '. as $o | try (if (.data|type) == "array" then .data |= map(select((((.info // {}).label? // "") != "广告") and (((.info // {}).title_prefix? // "") != "节目") and ((((.info // {}) | has("video_detail_info"))) | not))) else . end) catch $o'

# ===== 文章详情：去掉广告位、购车卡片、推荐与分享模块 =====
^https?:\/\/[a-zA-Z0-9.-]*dcarapi\.com\/motor\/information\/api\/full(\/|\?|$) response-body-json-jq '. as $o | try (if (.data|type) == "object" then del(.data.content_attitude, .data.motor_material_car_info, .data.ordered_info, .data.share_info) else . end) catch $o'

# ===== 搜索页：清空顶部推广提醒 =====
^https?:\/\/[a-zA-Z0-9.-]*dcarapi\.com\/motor\/searchpage\/launcher\/main\/v1(\/|\?|$) response-body-json-jq '. as $o | try (if (.data|type) == "object" then .data.more_remind = {} else . end) catch $o'

[Script]
# 开屏配置 / 悬浮挂件：返回结构合法的空数据，避免 reject 导致 App 回退或解析异常
http-response ^https?:\/\/[a-zA-Z0-9.-]*dcarapi\.com\/motor\/(ad|dlive\/api\/get_feed_widget)(\/|\?|$) requires-body=1,script-path=https://raw.githubusercontent.com/ashun520/loon-rules/main/Dongchedi/dongchedi_cleaner.js?v=20261113, max-size=10485760, timeout=30, tag=懂车帝广告清洗

[MITM]
# 只解密 API 主机。懂车帝「发现」等页面是 WebView(H5)，同样在 *.dcarapi.com 子域；
# 通配解密会让 WebView 证书校验失败（页面白屏/加载失败），所以不能通配。
hostname = api.dcarapi.com

# 规则依据：参考 xiaomaoJT/QxScript 公开的懂车帝规则并做保守化处理。
# 只重写已验证的广告配置与信息流接口，不拦截 dcarapi 普通内容接口，避免首页/详情页空白。
# 若某版本开屏改为第三方广告 SDK 投放，需补充对应广告平台域名。
